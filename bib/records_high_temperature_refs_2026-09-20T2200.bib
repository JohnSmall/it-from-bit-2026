@article{donofriorummukainen2016crossover,
  title = {Standard Model Cross-over on the Lattice},
  author = {D'Onofrio, Michela and Rummukainen, Kari},
  date = {2016},
  journaltitle = {Physical Review D},
  volume = {93},
  number = {2},
  eid = {025003},
  pages = {025003},
  doi = {10.1103/PhysRevD.93.025003},
  keywords = {electroweak crossover, lattice},
  note = {Verified 2026-09-20 against Crossref 10.1103/PhysRevD.93.025003 and
          INSPIRE-HEP (arXiv 1508.07161); published 7 January 2016. The
          document had the journal, volume and article number from memory and
          they were right.
          ---
          THE NUMBER CHECKS OUT. Their abstract: "With the physical Higgs
          mass the standard model symmetry restoration phase transition is a
          smooth cross-over ... While the cross-over is smooth, it is very
          well defined with a width of only ~5 GeV. We measure the cross-over
          temperature from the maximum of the susceptibility of the Higgs
          condensate, with the result T_c = 159.5 +/- 1.5 GeV." So the
          document's 159.5 +/- 1.5 GeV is exactly theirs, and so is the word
          "crossover", which is the authority for using it where Kuzmin,
          Rubakov and Shaposhnikov said "phase transition". Crossref prints
          the first author with a right single quotation mark, D'Onofrio; a
          plain apostrophe is used above.}
}

