@article{maldacena2016chaos,
  title = {A Bound on Chaos},
  author = {Maldacena, Juan and Shenker, Stephen H. and Stanford, Douglas},
  date = {2016},
  journaltitle = {Journal of High Energy Physics},
  volume = {2016},
  number = {8},
  eid = {106},
  pages = {106},
  doi = {10.1007/JHEP08(2016)106},
  eprint = {1503.01409},
  eprinttype = {arXiv},
  eprintclass = {hep-th},
  keywords = {chaos bound, scrambling},
  note = {Verified 2026-09-20 against Crossref 10.1007/JHEP08(2016)106 and
          INSPIRE-HEP recid 1347290 (texkey Maldacena:2015waa), arXiv
          1503.01409. NOTE THE VOLUME CONVENTION: the document cites this as
          "JHEP 08 (2016) 106", which is how the field writes it, but
          Crossref's volume is the YEAR, 2016, with the issue 8 and the
          article number 106. The entry follows Crossref. If the printed
          reference is to look like the field's convention that is a biblatex
          style question, not a data one.
          ---
          THE CLAIM CHECKS OUT, with one word to watch. Their abstract:
          "We conjecture a sharp bound on the rate of growth of chaos in
          thermal quantum systems with a large number of degrees of freedom
          ... Lyapunov exponent lambda_L <= 2 pi k_B T / hbar. We give a
          precise mathematical argument, based on plausible physical
          assumptions, establishing this conjecture." So the rate is indeed
          2 pi per thermal time hbar/k_B T, which is the document's "one turn
          of the imaginary column per thermal period". But the document says
          the bound is "derived", and the authors say conjectured, with an
          argument resting on plausible physical assumptions. Analyticity is
          part of that argument. If the paper leans on this, "conjectured,
          with an argument" is the accurate word.}
}

