@article{arnoldsonyaffe1997rate,
  title = {The Hot Baryon Violation Rate Is $O(\alpha_{W}^{5} T^{4})$},
  author = {Arnold, Peter and Son, Dam T. and Yaffe, Laurence G.},
  date = {1997},
  journaltitle = {Physical Review D},
  volume = {55},
  number = {10},
  pages = {6264--6273},
  doi = {10.1103/PhysRevD.55.6264},
  eprint = {hep-ph/9609481},
  eprinttype = {arXiv},
  eprintclass = {hep-ph},
  keywords = {sphaleron, rate},
  note = {NOT ON THE VERIFICATION LIST. Added 2026-09-20 because the records
          document attributes the alpha_W^5 scaling of the sphaleron rate to
          Kuzmin, Rubakov and Shaposhnikov, and it is not theirs. Verified
          against INSPIRE-HEP recid 423766 (texkey Arnold:1996dy), arXiv
          hep-ph/9609481, Phys. Rev. D 55, 6264--6273 (1997), doi
          10.1103/PhysRevD.55.6264.
          ---
          Their abstract settles the attribution: "The rate per unit volume
          for anomalous electroweak baryon number violation at high
          temperatures, in the symmetric phase, has been estimated in the
          literature to be O(alpha_W^4 T^4) based on simple scaling
          arguments. We argue that damping effects in the plasma suppress the
          rate by an extra power of alpha_W to give O(alpha_W^5 T^4)." So the
          fifth power is theirs, 1997, and the fourth power is the older
          estimate. The intermediate step is Arnold and McLerran, Phys. Rev.
          D 36, 581 (1987), doi 10.1103/PhysRevD.36.581, INSPIRE texkey
          Arnold:1987mh, which found a suppression from Landau damping and
          zero modes; it is not entered here because the document does not
          cite it, but it is the reference to add if the history is wanted.
          ---
          TITLE HAZARD: the published title contains a formula, and INSPIRE
          renders it as "O (alpha-w**5 T**4)". The LaTeX above is the
          intended form. Check it after the Zotero round trip, and if it is
          mangled, set it with a raw passthrough, `tex.title = ...` with an
          equals sign, per bib/README.md. Body not read beyond the abstract.}
}
