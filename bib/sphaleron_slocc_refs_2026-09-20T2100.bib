@article{chitambarduanshi2008tripartite,
  title = {Tripartite {{Entanglement Transformations}} and {{Tensor Rank}}},
  author = {Chitambar, Eric and Duan, Runyao and Shi, Yaoyun},
  date = {2008},
  journaltitle = {Physical Review Letters},
  volume = {101},
  number = {14},
  eid = {140502},
  pages = {140502},
  doi = {10.1103/PhysRevLett.101.140502},
  eprint = {0805.2977},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  keywords = {entanglement, SLOCC},
  note = {Verified 2026-09-20 against Crossref 10.1103/PhysRevLett.101.140502
          and arXiv:0805.2977v1, whose journal_ref gives Phys. Rev. Lett. 101,
          140502 (2008); the arXiv full text was read. Supports the paper's use
          fully. Their Theorem 1: (a) deciding SLOCC convertibility of general
          tripartite states is NP-hard, because "any general solution involves a
          tripartite tensor rank computation"; (b) GHZ^{\otimes 3} -> W^{\otimes 2}
          by SLOCC; (c) GHZ^{\otimes 17} -> EPR-triangle^{\otimes 6}; (d) the
          asymptotic GHZ-to-EPR exponent equals the matrix-multiplication
          exponent. So multi-copy inter-convertibility of the GHZ and W classes
          is their result, not an extrapolation. Two points worth keeping. They
          remark that "previously, only one copy of the W state is known to be
          convertible from three copies of GHZ", which is exactly the paper's
          own three-to-one construction at probability 3/64, so the paper's
          three-to-one is the pre-2008 rate and CDS improve the asymptotic rate
          rather than contradict it; and their headline caution is that tensor
          rank is NOT additive, so it bounds SLOCC convertibility rather than
          classifying it. The paper's explicit constructions are the framework's
          own and were re-run 2026-09-20: 2 GHZ -> W at 3/32, 2 W -> GHZ at 2/9,
          3 GHZ -> W at 3/64, all at fidelity 1.000000000000000
          (scripts/multicopy_slocc_conversion_2026-09-20T2100.py).}
}
