% Batch: the electroweak anomaly and multi-copy SLOCC conversion, cited by the
% Paper 1 passage "collective class conversion" added 2026-09-20 to the absent-gate
% subsection (scripts/patch_collective_class_conversion_2026-09-20T2100.py) and by
% knowledge/project-docs/sphaleron_slocc_collective_conversion_2026-09-20T2000.md.
%
% Written 2026-09-20T2100 by the Fable session from memory; VERIFIED 2026-09-20 by
% the Opus session against INSPIRE-HEP, Crossref and the sources themselves. Every
% field below is now taken from a record, not from memory. Changes made: 't Hooft
% pages 8 -> 8--11 and number added; Kuzmin et al. gained the Crossref DOI (it
% exists, contrary to the original note) and pages 36 -> 36--42; Chitambar et al.
% gained number, eprint and the published pagination as eid.
%
% ONE DISCREPANCY, reported not fixed: the paper's sentence attributes a
% TWELVE-fermion vertex with Delta B = Delta L = 3 to thooft1976symmetry. 't Hooft's
% Eq. (24) is the two-generation Weinberg-Salam model and gives EIGHT fermions with
% Delta B = Delta L = 2. See the note on that entry and the session report.
%
% thooft1976quantum is NOT cited by the paper as it stands. It is the companion
% paper carrying the detailed effective vertex, and it is here only because the
% proposed fix to the discrepancy above cites it alongside the Letter. If that fix
% is declined, delete this entry before importing.

@article{thooft1976symmetry,
  title = {Symmetry Breaking through {Bell}-{Jackiw} Anomalies},
  author = {family=Hooft, given=Gerard, prefix='t, useprefix=true},
  date = {1976},
  journaltitle = {Physical Review Letters},
  volume = {37},
  number = {1},
  pages = {8--11},
  doi = {10.1103/PhysRevLett.37.8},
  keywords = {anomaly, sphaleron},
  note = {Verified 2026-09-20 against INSPIRE-HEP recid 3438 (texkey
          tHooft:1976rip), Crossref 10.1103/PhysRevLett.37.8, and the scanned
          Letter itself at staff.science.uu.nl/~hooft101/gthpub/symm_br_bell_jackiw.pdf.
          Volume 37, number 1, pages 8--11, issue of 5 July 1976: all confirmed
          from the page headers and footers of the scan. CAUTION on what it
          supports. The Letter's Standard-Model application, Eq. (24) on page 10,
          is the TWO-generation Weinberg-Salam model: Delta E = Delta M = 1,
          Delta u + Delta d^C = 3, Delta u' + Delta s^C = 3, i.e. eight fermions
          with Delta B = Delta L = 2, glossed there as "a proton and a neutron
          (two baryons equal six quarks) may annihilate to form two antileptons,
          one of electron and one of muon type". The three-generation
          twelve-fermion vertex with Delta B = Delta L = 3 is the standard
          extension, not 't Hooft's own statement, and B-L conservation is
          implicit in Eq. (24) rather than asserted. The suppression is his
          Eq. (17), exp(-8 pi^2 / g^2) in the amplitude, quoted on page 10 as
          exp(-16 pi^2 / g^2) = exp(-4 pi / alpha_W) in rates.}
}

