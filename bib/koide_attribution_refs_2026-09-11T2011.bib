@unpublished{brannen2006lepton,
  title = {The {{Lepton Masses}}},
  author = {Brannen, Carl A.},
  date = {2006-05-02},
  url = {https://brannenworks.com/MASSES2.pdf},
  urldate = {2026-09-11},
  keywords = {mass},
  note = {Unpublished note, Liquafaction Corp., Woodinville, WA; dated 2 May
          2006 on the document itself. Read in full 2026-09-11. Source of the
          Koide phase as a number: writes the square-root masses as the
          eigenvalues of the circulant Hermitian matrix with unit diagonal and
          off-diagonal entries eta*exp(+/- i delta), so that
          lambda_n = mu (1 + 2 eta cos(delta + 2 pi n / 3)), fits
          eta_1^2 = 0.500003(23) and delta_1 = 0.2222220(19) to the PDG
          charged-lepton masses, and states that "delta_1 is close to 2/9, a
          fact that went unnoticed until this author discovered it in 2005".
          Note that eta^2 = 1/2 is the framework's alpha = 2 eta = sqrt 2, and
          that the circulant eigenvalue form is the complex case of
          prop:koide-jordan. The tau mass he quotes is
          1776.99 (+0.29 -0.26) MeV, the PDG value of the day.}
}

