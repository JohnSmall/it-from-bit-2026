@article{backens2014zx,
  author = {Backens, Miriam},
  title = {The {ZX}-calculus is complete for stabilizer quantum mechanics},
  date = {2014},
  journaltitle = {New Journal of Physics},
  volume = {16},
  eid = {093021},
  doi = {10.1088/1367-2630/16/9/093021},
  eprint = {1307.7025},
  eprinttype = {arXiv},
  url = {https://arxiv.org/abs/1307.7025},
  urldate = {2026-10-18},
  note = {Metadata verified against the arXiv record. Support: full-text
    section 2.1 defines Clifford operations, gives the complex-linear phase
    gate and the 24 single-qubit Clifford operations modulo global phase;
    section 5 states that there are six single-qubit pure stabilizer states.
    Used as a counterexample to complex amplitudes alone implying
    continuously available transformations. No claim that the source models
    a complete self-describing observer.}
}

