@article{guryanova2020projective,
  title = {Ideal Projective Measurements Have Infinite Resource Costs},
  author = {Guryanova, Yelena and Friis, Nicolai and Huber, Marcus},
  journaltitle = {Quantum},
  volume = {4},
  pages = {222},
  date = {2020},
  doi = {10.22331/q-2020-01-13-222},
  eprint = {1805.11899},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  keywords = {thermodynamics, measurement},
  note = {Read in full 2026-09-20 from the Quantum open-access PDF
          (quantum-journal.org/papers/q-2020-01-13-222/, arXiv:1805.11899v3,
          accepted 2019-12-17, published 2020-01-13). Bibliographic fields
          confirmed against Crossref.
          ---
          WHAT KIND OF COST IT IS, since the batch was told to settle this.
          It is an ENERGY cost paid in FINITE TIME, not an entropy cost, and
          the paper never forms the product of the two or uses the word
          action. The abstract promises "tight analytic expressions for the
          energy cost", split into preparing the pointer and correlating it
          with the system. The divergence is stated three ways and they are
          interchangeable: Appendix A.IV.3 says procedures that reduce the
          rank "use either infinite energy E, take infinite time t (an
          infinite sequence of finite interaction range operations) or are
          infinitely complex (infinite interaction range operations)". Section
          6 makes the trade explicit: "Within our cooling paradigm, the energy
          cost for reaching the ground state in finite time is infinite. Other
          paradigms allow cooling to the ground state using finite energy, but
          require infinite time." The Discussion's summary is "ideal
          finite-time projective measurements have an infinite cost".
          ---
          So the energy--time pair is what diverges, which is the shape of an
          action but is not called one, and the framework cannot cite them for
          an action reading without saying that the product is its own step.
          Entropy is NOT the divergent quantity: it appears only in the
          appendix, where the thermal pointer state "minimizes the energy at
          fixed entropy" and "maximizes the entropy" at fixed energy, bounding
          the work cost from below. The third law is the reason for the
          divergence, not the price of it.
          ---
          Two fences worth carrying into v2 item 5. The divergence is
          conditional: it holds "unless pure states are freely available",
          which the framework should not quietly assume. And the approximation
          is cheap: "ideal measurements can be approximated by non-ideal,
          unbiased ones to arbitrary precision at finite energy cost". The
          infinity is in the last step to perfect correlation, not in making a
          good record.}
}

