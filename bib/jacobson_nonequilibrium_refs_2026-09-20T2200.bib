@article{chircoliberati2010dissipation,
  title = {Nonequilibrium Thermodynamics of Spacetime: The Role of Gravitational Dissipation},
  author = {Chirco, Goffredo and Liberati, Stefano},
  date = {2010},
  journaltitle = {Physical Review D},
  volume = {81},
  number = {2},
  eid = {024016},
  pages = {024016},
  doi = {10.1103/PhysRevD.81.024016},
  eprint = {0909.4194},
  eprinttype = {arXiv},
  eprintclass = {gr-qc},
  keywords = {spacetime thermodynamics, viscosity},
  note = {Verified 2026-09-20 against Crossref 10.1103/PhysRevD.81.024016;
          published 15 January 2010. Crossref gives the authors as initials,
          "Chirco, G." and "Liberati, S."; the full first names above should
          be checked after import. Published title is "Nonequilibrium", one
          word. THE BODY WAS READ (arXiv:0909.4194) because section 4 plans
          to inherit a coefficient from it.
          ---
          THE CLAIM HOLDS BUT THE ATTRIBUTION IS WRONG. They do give
          eta = 1/(16 pi G) and they do tie it to the membrane paradigm and
          to the AdS/CFT universal ratio. But in their section 2 the sentence
          is "it is also noticed in [2] that by using (19), one gets
          eta = 1/(16 pi G) in agreement with the value obtained for the
          shear viscosity of the stretched horizon of a black hole in the so
          called membrane paradigm", followed by "This result concludes the
          review of the argument described in [1, 2, 12]." Their reference
          [2] is Eling, Guedens and Jacobson; [27] and [30] are Price and
          Thorne and the membrane-paradigm literature. Later, in their own
          setting, they re-derive it: "one can actually interpret the
          expression in (44) as the standard entropy production term for a
          fluid with shear viscosity eta, defined by alpha/T = 2 eta/kappa,
          that is eta = hbar alpha / 4 pi, in agreement with the universal
          relation for the viscosity to entropy density ratio found in the
          AdS/CFT context". So the coefficient is the membrane paradigm's,
          reviewed and then re-derived by them, and "the Chirco--Liberati
          coefficient" over-credits them. Their own result is that the
          internal entropy production term in GR "is identical to the so
          called tidal heating term of Hartle-Hawking", which is a different
          statement from the one section 4 attributes to them. Note also that
          they do not write 1/(4 pi) as a number anywhere in the passages
          read; they point at the AdS/CFT universal relation instead.}
}

